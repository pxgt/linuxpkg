///|
fn sha256_hex(data : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(data))
}

///|
fn compare_bytes(a : Bytes, b : Bytes) -> Int32 {
  let shared = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<shared {
    if a[i] != b[i] {
      return a[i].to_int() - b[i].to_int()
    }
  }
  a.length() - b.length()
}

///|
/// `[epoch:]version-release`, the `pkgver` of `.PKGINFO`.
fn pkgver(spec : @spec.PackageSpec) -> String {
  if spec.epoch > 0 {
    "\{spec.epoch}:\{spec.version}-\{spec.release}"
  } else {
    "\{spec.version}-\{spec.release}"
  }
}

///|
/// The file name makepkg would use, for example
/// `hello-1.0.0-1-x86_64.pkg.tar.zst`. The epoch, when set, is part of it.
pub fn file_name(
  spec : @spec.PackageSpec,
  compression~ : @compress.Compression = Zstd,
) -> String {
  let arch = match spec.arch.pacman_name() {
    Some(name) => name
    None => spec.arch.rpm_name()
  }
  "\{spec.name}-\{pkgver(spec)}-\{arch}.pkg.tar\{compression.extension()}"
}

///|
fn op_text(op : @spec.VersionOp) -> String {
  match op {
    Lt => "<"
    Le => "<="
    Eq => "="
    Ge => ">="
    Gt => ">"
  }
}

///|
/// `name`, `name>=1.0` and so on, the way pacman writes relations.
fn relation(dep : @spec.Dependency) -> String {
  match dep.constraint {
    None => dep.name
    Some((op, version)) => "\{dep.name}\{op_text(op)}\{version}"
  }
}

///|
fn add(out : StringBuilder, key : String, value : String) -> Unit {
  out.write_string("\{key} = \{value}\n")
}

///|
fn first_line(text : String) -> String {
  match text.split("\n").next() {
    Some(line) => line.trim().to_owned()
    None => ""
  }
}

///|
/// Contents of `.PKGINFO`. Key order follows makepkg.
fn pkginfo(
  spec : @spec.PackageSpec,
  arch : String,
  size : Int64,
) -> String raise ArchError {
  let out = StringBuilder()
  out.write_string("# Generated by linuxpkg\n")
  add(out, "pkgname", spec.name)
  add(out, "pkgbase", spec.name)
  add(out, "xdata", "pkgtype=pkg")
  add(out, "pkgver", pkgver(spec))
  add(out, "pkgdesc", first_line(spec.description))
  match spec.homepage {
    Some(url) => add(out, "url", url)
    None => ()
  }
  add(out, "builddate", spec.mtime.to_string())
  add(out, "packager", spec.maintainer)
  add(out, "size", size.to_string())
  add(out, "arch", arch)
  add(
    out,
    "license",
    match spec.license {
      Some(text) => text
      None => "custom"
    },
  )
  for dep in spec.replaces {
    add(out, "replaces", relation(dep))
  }
  for dep in spec.conflicts {
    add(out, "conflict", relation(dep))
  }
  for dep in spec.provides {
    match dep.constraint {
      Some((op, _)) if op != Eq =>
        raise ArchError::Invalid(
          field="provides",
          message="\"\{dep.name}\": pacman only accepts = in a provide",
        )
      _ => add(out, "provides", relation(dep))
    }
  }
  let backup : Array[String] = []
  for entry in spec.entries {
    if entry.config {
      backup.push(entry.path[1:].to_owned())
    }
  }
  backup.sort_by((a, b) => compare_bytes(@utf8.encode(a), @utf8.encode(b)))
  for path in backup {
    add(out, "backup", path)
  }
  for dep in spec.depends {
    add(out, "depend", relation(dep))
  }
  // pacman has a single kind of weak dependency: optional ones.
  for dep in spec.recommends {
    add(out, "optdepend", relation(dep))
  }
  for dep in spec.suggests {
    add(out, "optdepend", relation(dep))
  }
  out.to_string()
}

///|
/// Maintainer scripts as the functions pacman looks for in `.INSTALL`. The
/// upgrade functions run the install ones, so a script behaves the same on
/// first install and on upgrade, as it does in a deb or an rpm.
fn install_script(spec : @spec.PackageSpec) -> String? raise ArchError {
  let s = spec.scripts
  if s.pre_install is None &&
    s.post_install is None &&
    s.pre_remove is None &&
    s.post_remove is None {
    return None
  }
  let out = StringBuilder()
  out.write_string("# Generated by linuxpkg\n")
  let function = (name : String, field : String, body : String?) => {
    match body {
      None => ()
      Some(text) => {
        if !text.has_prefix("#!") {
          raise ArchError::Invalid(
            field~,
            message="must start with #! (a shebang line)",
          )
        }
        // The shebang line is dropped: the code runs inside pacman's shell.
        let lines = text.split("\n").collect()
        let mut last = lines.length()
        while last > 1 && lines[last - 1].trim() == "" {
          last -= 1
        }
        out.write_string("\n\{name}() {\n")
        for i in 1..<last {
          let line = lines[i]
          if line.trim() == "" {
            out.write_string("\n")
          } else {
            out.write_string("  \{line}\n")
          }
        }
        out.write_string("  :\n}\n")
      }
    }
  }
  function("pre_install", "scripts.pre_install", s.pre_install)
  function("post_install", "scripts.post_install", s.post_install)
  function("pre_remove", "scripts.pre_remove", s.pre_remove)
  function("post_remove", "scripts.post_remove", s.post_remove)
  if s.pre_install is Some(_) {
    out.write_string("\npre_upgrade() {\n  pre_install\n}\n")
  }
  if s.post_install is Some(_) {
    out.write_string("\npost_upgrade() {\n  post_install\n}\n")
  }
  Some(out.to_string())
}

///|
fn octal(value : Int32) -> String {
  if value == 0 {
    return "0"
  }
  let digits : Array[Char] = []
  let mut rest = value
  while rest > 0 {
    digits.push((48 + rest % 8).unsafe_to_char())
    rest = rest / 8
  }
  let out = StringBuilder()
  for i = digits.length() - 1; i >= 0; i = i - 1 {
    out.write_char(digits[i])
  }
  out.to_string()
}

///|
/// mtree spells awkward bytes of a path as `\ooo`.
fn mtree_quote(path : String) -> String {
  let out = StringBuilder()
  for b in @utf8.encode(path) {
    let c = b.to_int()
    if c <= 32 ||
      c >= 127 ||
      c == 92 ||
      c == 35 ||
      c == 61 ||
      c == 42 ||
      c == 63 ||
      c == 91 {
      out.write_string("\\")
      out.write_string(String::make(3 - octal(c).length(), '0'))
      out.write_string(octal(c))
    } else {
      out.write_char(c.unsafe_to_char())
    }
  }
  out.to_string()
}

///|
/// One line of `.MTREE` for a tar entry.
fn mtree_line(entry : @tar.Entry, path : String) -> String {
  let out = StringBuilder()
  out.write_string("./\{mtree_quote(path)} time=\{entry.mtime}.0")
  let mode = entry.mode & 0o7777
  match entry.kind {
    File(content) => {
      if mode != 0o644 {
        out.write_string(" mode=\{octal(mode)}")
      }
      out.write_string(
        " size=\{content.length()} sha256digest=\{sha256_hex(content)}",
      )
    }
    Dir => out.write_string(" mode=\{octal(mode)} type=dir")
    Symlink(target) =>
      out.write_string(
        " mode=\{octal(mode)} type=link link=\{mtree_quote(target)}",
      )
    _ => ()
  }
  out.to_string()
}

///|
/// All proper ancestors of an absolute path, outermost first.
fn parent_dirs(path : String) -> Array[String] {
  let dirs : Array[String] = []
  for i in 1..<path.length() {
    if path[i] == '/' {
      dirs.push(path[0:i].to_owned())
    }
  }
  dirs
}

///|
priv struct Node {
  key : Bytes
  entry : @tar.Entry
}

///|
fn data_entries(spec : @spec.PackageSpec) -> Array[@tar.Entry] {
  let present : Map[String, Bool] = Map([])
  for entry in spec.entries {
    present[entry.path] = true
  }
  let nodes : Array[Node] = []
  for entry in spec.entries {
    for dir in parent_dirs(entry.path) {
      if !present.contains(dir) {
        present[dir] = true
        nodes.push({
          key: @utf8.encode(dir),
          entry: @tar.Entry::dir(dir[1:].to_owned(), mtime=spec.mtime),
        })
      }
    }
  }
  for entry in spec.entries {
    let path = entry.path[1:].to_owned()
    let mtime = match entry.mtime {
      Some(t) => t
      None => spec.mtime
    }
    let tar_entry = match entry.kind {
      File(content) =>
        @tar.Entry::file(
          path,
          content,
          mode=entry.mode,
          uname=entry.owner,
          gname=entry.group,
          mtime~,
        )
      Dir =>
        @tar.Entry::dir(
          path,
          mode=entry.mode,
          uname=entry.owner,
          gname=entry.group,
          mtime~,
        )
      Symlink(target) =>
        @tar.Entry::symlink(
          path,
          target,
          uname=entry.owner,
          gname=entry.group,
          mtime~,
        )
    }
    nodes.push({ key: @utf8.encode(entry.path), entry: tar_entry, })
  }
  nodes.sort_by((a, b) => compare_bytes(a.key, b.key))
  nodes.map(n => n.entry)
}

///|
/// Build an Arch Linux package (`.pkg.tar.*`) from a package description.
///
/// The tar archive holds `.INSTALL` (if there are maintainer scripts),
/// `.MTREE` (gzip compressed, with the SHA-256 of every file), `.PKGINFO` and
/// then the files with paths relative to `/`, sorted by path with every parent
/// directory present. `compression` defaults to zstd like `makepkg`. The same
/// input always gives the same bytes. Files are owned by the user and group
/// named in the entry; numeric ids are 0.
pub fn build(
  spec : @spec.PackageSpec,
  compression~ : @compress.Compression = Zstd,
) -> Bytes raise ArchError {
  if compression == Lzma {
    raise ArchError::Invalid(
      field="compression",
      message="lzma cannot be written, use zstd, xz, gzip or none",
    )
  }
  spec.validate() catch {
    @spec.SpecError::Invalid(field~, message~) =>
      raise ArchError::Invalid(field~, message~)
  }
  let arch = match spec.arch.pacman_name() {
    Some(name) => name
    None =>
      raise ArchError::Invalid(
        field="arch",
        message="Arch Linux has no port for \{spec.arch.deb_name()}",
      )
  }
  // pkgrel is a number such as 1 or 1.1.
  let release = spec.release
  let mut valid = release.length() > 0
  let mut dots = 0
  for c in release {
    if c == '.' {
      dots += 1
    } else if !(c is ('0'..<='9')) {
      valid = false
    }
  }
  if !valid || dots > 1 || release.has_prefix(".") || release.has_suffix(".") {
    raise ArchError::Invalid(
      field="release",
      message="must be a number such as 1 or 1.1 for an Arch Linux package",
    )
  }
  if spec.version.contains("-") {
    raise ArchError::Invalid(
      field="version",
      message="must not contain a hyphen",
    )
  }
  let files = data_entries(spec)
  let mut size = 0L
  for e in files {
    match e.kind {
      File(content) => size += content.length().to_int64()
      _ => ()
    }
  }
  let info = @utf8.encode(pkginfo(spec, arch, size))
  let install = match install_script(spec) {
    Some(text) => Some(@utf8.encode(text))
    None => None
  }
  let mtime = spec.mtime
  let head : Array[@tar.Entry] = []
  match install {
    Some(text) => head.push(@tar.Entry::file(".INSTALL", text, mtime~))
    None => ()
  }
  let mtree = StringBuilder()
  mtree.write_string("#mtree\n/set type=file uid=0 gid=0 mode=644\n")
  match install {
    Some(text) =>
      mtree.write_string(
        "\{mtree_line(@tar.Entry::file(".INSTALL", text, mtime~), ".INSTALL")}\n",
      )
    None => ()
  }
  let info_entry = @tar.Entry::file(".PKGINFO", info, mtime~)
  mtree.write_string("\{mtree_line(info_entry, ".PKGINFO")}\n")
  for e in files {
    mtree.write_string("\{mtree_line(e, e.path)}\n")
  }
  let mtree_gz = @compress.compress(@utf8.encode(mtree.to_string()), Gzip) catch {
    err => raise ArchError::Invalid(field=".MTREE", message="\{err}")
  }
  head.push(@tar.Entry::file(".MTREE", mtree_gz, mtime~))
  head.push(info_entry)
  let all = [..head, ..files]
  let tar = @tar.build(all, long_names=Gnu) catch {
    err => raise ArchError::Invalid(field="package", message="\{err}")
  }
  @compress.compress(tar, compression) catch {
    err => raise ArchError::Invalid(field="package", message="\{err}")
  }
}
