///|
fn hex(bytes : FixedArray[Byte]) -> String {
  @crypto.bytes_to_hex_string(bytes)
}

///|
fn sha1_hex(data : Bytes) -> String {
  hex(@crypto.sha1(data))
}

///|
fn sha256_hex(data : Bytes) -> String {
  hex(@crypto.sha256(data))
}

///|
fn compare_bytes(a : Bytes, b : Bytes) -> Int32 {
  let shared = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<shared {
    if a[i] != b[i] {
      return a[i].to_int() - b[i].to_int()
    }
  }
  a.length() - b.length()
}

///|
/// The name apk uses for an architecture, or `None` when Alpine has no port
/// of it (`armel`, `mips64le`).
pub fn arch_name(arch : @spec.Arch) -> String? {
  match arch {
    Amd64 => Some("x86_64")
    Arm64 => Some("aarch64")
    I386 => Some("x86")
    Armhf => Some("armv7")
    Ppc64le => Some("ppc64le")
    S390x => Some("s390x")
    Riscv64 => Some("riscv64")
    Loong64 => Some("loongarch64")
    All => Some("noarch")
    Armel | Mips64le => None
  }
}

///|
/// Is this an apk version: digits with dots, an optional letter, then
/// suffixes such as `_rc1` or `_p2` (`1.2.3`, `2.0b`, `1.0_rc1`)?
fn valid_version(version : String) -> Bool {
  let parts = version.split("_").collect()
  let head = parts[0].to_owned()
  let mut i = 0
  let mut digits = 0
  let mut groups = 0
  while i < head.length() {
    let c = head[i]
    if c is ('0'..<='9') {
      digits += 1
    } else if c == '.' && digits > 0 {
      groups += 1
      digits = 0
    } else if c is ('a'..<='z') && i == head.length() - 1 && digits > 0 {
      return check_suffixes(parts)
    } else {
      return false
    }
    i += 1
  }
  digits > 0 && check_suffixes(parts) && groups >= 0
}

///|
fn check_suffixes(parts : Array[StringView]) -> Bool {
  for i in 1..<parts.length() {
    let part = parts[i].to_owned()
    let mut ok = false
    for name in ["alpha", "beta", "pre", "rc", "cvs", "svn", "git", "hg", "p"] {
      if part.has_prefix(name) {
        let rest = part[name.length():].to_owned()
        ok = true
        for c in rest {
          if !(c is ('0'..<='9')) {
            ok = false
          }
        }
        if ok {
          break
        }
      }
    }
    if !ok {
      return false
    }
  }
  true
}

///|
/// `pkgver`: the version with the revision, `1.2.3-r4`.
fn pkgver(spec : @spec.PackageSpec) -> String {
  "\{apk_version(spec.version)}-r\{spec.release}"
}

///|
/// The version as apk writes it: the `~` that linuxpkg uses for pre-releases
/// (`1.0~rc1`) is apk's `_` (`1.0_rc1`).
fn apk_version(version : String) -> String {
  version.replace_all(old="~", new="_")
}

///|
/// The file name abuild uses: `hello-1.0.0-r1.apk`.
pub fn file_name(spec : @spec.PackageSpec) -> String {
  "\{spec.name}-\{pkgver(spec)}.apk"
}

///|
fn op_text(op : @spec.VersionOp) -> String {
  match op {
    Lt => "<"
    Le => "<="
    Eq => "="
    Ge => ">="
    Gt => ">"
  }
}

///|
fn relation(dep : @spec.Dependency) -> String {
  match dep.constraint {
    None => dep.name
    Some((op, version)) => "\{dep.name}\{op_text(op)}\{version}"
  }
}

///|
fn add(out : StringBuilder, key : String, value : String) -> Unit {
  out.write_string("\{key} = \{value}\n")
}

///|
fn first_line(text : String) -> String {
  match text.split("\n").next() {
    Some(line) => line.trim().to_owned()
    None => ""
  }
}

///|
fn pkginfo(
  spec : @spec.PackageSpec,
  arch : String,
  size : Int64,
  datahash : String,
) -> String {
  let out = StringBuilder()
  out.write_string("# Generated by linuxpkg\n")
  add(out, "pkgname", spec.name)
  add(out, "pkgver", pkgver(spec))
  add(out, "pkgdesc", first_line(spec.description))
  match spec.homepage {
    Some(url) => add(out, "url", url)
    None => ()
  }
  add(out, "builddate", spec.mtime.to_string())
  add(out, "packager", spec.maintainer)
  add(out, "size", size.to_string())
  add(out, "arch", arch)
  add(out, "origin", spec.name)
  match spec.license {
    Some(text) => add(out, "license", text)
    None => ()
  }
  for dep in spec.replaces {
    add(out, "replaces", relation(dep))
  }
  for dep in spec.provides {
    add(out, "provides", relation(dep))
  }
  for dep in spec.depends {
    add(out, "depend", relation(dep))
  }
  // apk marks a conflict with a leading "!".
  for dep in spec.conflicts {
    add(out, "depend", "!" + relation(dep))
  }
  add(out, "datahash", datahash)
  out.to_string()
}

///|
priv struct Node {
  key : Bytes
  item : (@tar.Entry, Array[(String, String)])
}

///|
fn parent_dirs(path : String) -> Array[String] {
  let dirs : Array[String] = []
  for i in 1..<path.length() {
    if path[i] == '/' {
      dirs.push(path[0:i].to_owned())
    }
  }
  dirs
}

///|
/// The data tar entries with every parent directory, sorted by path, and the
/// installed size.
fn data_entries(
  spec : @spec.PackageSpec,
) -> (Array[(@tar.Entry, Array[(String, String)])], Int64) {
  let present : Map[String, Bool] = Map([])
  for entry in spec.entries {
    present[entry.path] = true
  }
  let nodes : Array[Node] = []
  let mut size = 0L
  for entry in spec.entries {
    for dir in parent_dirs(entry.path) {
      if !present.contains(dir) {
        present[dir] = true
        nodes.push({
          key: @utf8.encode(dir),
          item: (@tar.Entry::dir(dir[1:].to_owned(), mtime=spec.mtime), []),
        })
      }
    }
  }
  for entry in spec.entries {
    let path = entry.path[1:].to_owned()
    let mtime = match entry.mtime {
      Some(t) => t
      None => spec.mtime
    }
    let item = match entry.kind {
      File(content) => {
        size += content.length().to_int64()
        (
          @tar.Entry::file(
            path,
            content,
            mode=entry.mode,
            uname=entry.owner,
            gname=entry.group,
            mtime~,
          ),
          [("APK-TOOLS.checksum.SHA1", sha1_hex(content))],
        )
      }
      Dir =>
        (
          @tar.Entry::dir(
            path,
            mode=entry.mode,
            uname=entry.owner,
            gname=entry.group,
            mtime~,
          ),
          [],
        )
      Symlink(target) =>
        // abuild records the SHA-1 of the link text for symbolic links.
        (
          @tar.Entry::symlink(
            path,
            target,
            uname=entry.owner,
            gname=entry.group,
            mtime~,
          ),
          [("APK-TOOLS.checksum.SHA1", sha1_hex(@utf8.encode(target)))],
        )
    }
    nodes.push({ key: @utf8.encode(entry.path), item, })
  }
  nodes.sort_by((a, b) => compare_bytes(a.key, b.key))
  (nodes.map(n => n.item), size)
}

///|
fn script_entries(spec : @spec.PackageSpec) -> Array[@tar.Entry] raise ApkError {
  let result : Array[@tar.Entry] = []
  let s = spec.scripts
  let add_script = (names : Array[String], field : String, body : String?) => {
    match body {
      None => ()
      Some(text) => {
        if !text.has_prefix("#!") {
          raise ApkError::Invalid(
            field~,
            message="must start with #! (a shebang line)",
          )
        }
        for name in names {
          result.push(
            @tar.Entry::file(
              name,
              @utf8.encode(text),
              mode=0o755,
              mtime=spec.mtime,
            ),
          )
        }
      }
    }
  }
  // Like a deb or an rpm, the install scripts also run on upgrades.
  add_script(
    [".post-install", ".post-upgrade"],
    "scripts.post_install",
    s.post_install,
  )
  add_script([".post-deinstall"], "scripts.post_remove", s.post_remove)
  add_script(
    [".pre-install", ".pre-upgrade"],
    "scripts.pre_install",
    s.pre_install,
  )
  add_script([".pre-deinstall"], "scripts.pre_remove", s.pre_remove)
  result.sort_by((a, b) => {
    compare_bytes(@utf8.encode(a.path), @utf8.encode(b.path))
  })
  result
}

///|
/// Build an Alpine Linux package (`.apk`, format 2) from a package
/// description: two gzip streams, one after the other, holding the control
/// tar (`.PKGINFO` and the scripts, without an end marker) and the data tar
/// (files with their SHA-1 in a PAX record, as abuild writes them).
/// `.PKGINFO` records the SHA-256 of the data stream as `datahash`. The
/// package is not signed, so `apk add --allow-untrusted` installs it. The
/// same input always gives the same bytes.
pub fn build(spec : @spec.PackageSpec) -> Bytes raise ApkError {
  spec.validate() catch {
    @spec.SpecError::Invalid(field~, message~) =>
      raise ApkError::Invalid(field~, message~)
  }
  let arch = match arch_name(spec.arch) {
    Some(name) => name
    None =>
      raise ApkError::Invalid(
        field="arch",
        message="Alpine Linux has no port for \{spec.arch.deb_name()}",
      )
  }
  if spec.epoch != 0 {
    raise ApkError::Invalid(field="epoch", message="apk packages have no epoch")
  }
  if !valid_version(apk_version(spec.version)) {
    raise ApkError::Invalid(
      field="version",
      message="\"\{spec.version}\" is not an apk version (digits and dots, an optional letter, suffixes such as _rc1)",
    )
  }
  let mut numeric = spec.release.length() > 0
  for c in spec.release {
    if !(c is ('0'..<='9')) {
      numeric = false
    }
  }
  if !numeric {
    raise ApkError::Invalid(
      field="release",
      message="must be a number for an apk package (it becomes -r<number>)",
    )
  }
  let (items, size) = data_entries(spec)
  let data_tar = @tar.build_with_records(items) catch {
    err => raise ApkError::Invalid(field="data", message="\{err}")
  }
  let data_gz = @compress.compress(data_tar, Gzip) catch {
    err => raise ApkError::Invalid(field="data", message="\{err}")
  }
  let info = @utf8.encode(pkginfo(spec, arch, size, sha256_hex(data_gz)))
  let control : Array[(@tar.Entry, Array[(String, String)])] = [
    (@tar.Entry::file(".PKGINFO", info, mtime=spec.mtime), []),
  ]
  for script in script_entries(spec) {
    control.push((script, []))
  }
  let control_tar = @tar.build_with_records(control, end_marker=false) catch {
    err => raise ApkError::Invalid(field="control", message="\{err}")
  }
  let control_gz = @compress.compress(control_tar, Gzip) catch {
    err => raise ApkError::Invalid(field="control", message="\{err}")
  }
  Bytes::from_array([..control_gz, ..data_gz])
}
